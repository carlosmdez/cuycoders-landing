---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { getCopy, type Locale } from '../../../i18n/content';
import { ArrowLeft } from '@lucide/astro';
import CuyMark from '../../../components/CuyMark.astro';
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { lang: post.data.locale, id: post.id },
    props: {
      post,
      alternate: posts.find(
        (p) =>
          p.data.translationKey === post.data.translationKey &&
          p.data.locale !== post.data.locale,
      ),
    },
  }));
}
const { post, alternate } = Astro.props;
const locale = post.data.locale as Locale;
const c = getCopy(locale);
const { Content } = await render(post);
const alternatePath = alternate
  ? `/${alternate.data.locale}/blog/${alternate.id}/`
  : `/${locale === 'es' ? 'en' : 'es'}/blog/`;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  inLanguage: locale,
  datePublished: post.data.published.toISOString(),
  author: { '@type': 'Organization', name: 'Cuy Coders' },
  publisher: {
    '@type': 'Organization',
    name: 'Cuy Coders',
    ...(Astro.site ? { url: Astro.site.href } : {}),
  },
  ...(Astro.site
    ? { mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href }
    : {}),
};
---

<Layout
  locale={locale}
  title={`${post.data.title} | Cuy Coders`}
  description={post.data.description}
  alternatePath={alternatePath}
  schema={schema}
>
  <article class="article wrap">
    <header class="article-heading">
      <a class="text-link" href={`/${locale}/blog/`}>
        <ArrowLeft size={17} />
        {c.common.allArticles}
      </a>
      <div class="article-meta">
        <span>{post.data.category}</span>
        <span>
          {post.data.readTime} {c.common.minutes}
        </span>
      </div>
      <h1>{post.data.title}</h1>
      <p class="article-deck">{post.data.description}</p>
      <div class="article-author">
        <CuyMark size={40} class="author-mark" />
        <span>
          Cuy Coders
          <br />
          <time datetime={post.data.published.toISOString()}>
            {post.data.published.toLocaleDateString(
              locale === 'es' ? 'es-MX' : 'en-US',
              {
                day: 'numeric',
                month: 'long',
                year: 'numeric',
                timeZone: 'UTC',
              },
            )}
          </time>
        </span>
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Layout>
