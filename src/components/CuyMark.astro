---
interface Props {
  size?: number;
  class?: string;
}
const { size = 40, class: className } = Astro.props;
// Rendered several times per page, so the clip id must be unique.
const headClip = `cuy-head-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  class:list={['cuy-mark', className]}
  width={size}
  height={size}
  viewBox="0 0 40 40"
  fill="none"
  aria-hidden="true"
>
  <defs>
    <clipPath id={headClip}>
      <ellipse cx="20" cy="40" rx="17" ry="16"></ellipse>
    </clipPath>
  </defs>
  <rect width="40" height="40" fill="currentColor"></rect>
  <!-- A guinea pig peeking up from the bottom edge of the badge. -->
  <g class="brand-cuy">
    <g transform="translate(20 40) scale(1.3) translate(-20 -40)">
      <ellipse
        cx="9.6"
        cy="26.4"
        rx="4.2"
        ry="5.4"
        transform="rotate(-38 9.6 26.4)"
        fill="#fff8ee"></ellipse>
      <ellipse
        cx="9.2"
        cy="25.7"
        rx="2.3"
        ry="3.3"
        transform="rotate(-38 9.2 25.7)"
        fill="#f2ba9c"></ellipse>
      <ellipse
        cx="30.4"
        cy="26.4"
        rx="4.2"
        ry="5.4"
        transform="rotate(38 30.4 26.4)"
        fill="#e3a46c"></ellipse>
      <ellipse
        cx="30.8"
        cy="25.7"
        rx="2.3"
        ry="3.3"
        transform="rotate(38 30.8 25.7)"
        fill="#f2ba9c"></ellipse>
      <ellipse cx="20" cy="40" rx="17" ry="16" fill="#fff8ee"></ellipse>
      <ellipse
        cx="29"
        cy="29"
        rx="8"
        ry="7"
        fill="#e3a46c"
        clip-path={`url(#${headClip})`}></ellipse>
      <ellipse cx="14.4" cy="32" rx="1.9" ry="2.2" fill="#242923"></ellipse>
      <ellipse cx="25.6" cy="32" rx="1.9" ry="2.2" fill="#242923"></ellipse>
      <circle cx="15.1" cy="31.2" r=".7" fill="#fff"></circle>
      <circle cx="26.3" cy="31.2" r=".7" fill="#fff"></circle>
      <ellipse cx="11" cy="35.6" rx="2" ry="1.1" fill="#f2ba9c"></ellipse>
      <ellipse cx="29" cy="35.6" rx="2" ry="1.1" fill="#f2ba9c"></ellipse>
      <path
        d="M18.5 35h3c.5 0 .7.6.3.9l-1.4 1.2a.6.6 0 0 1-.8 0l-1.4-1.2c-.4-.3-.2-.9.3-.9Z"
        fill="#bb4724"></path>
    </g>
  </g>
</svg>
