---
import { Image } from 'astro:assets';
import cuyLogo from '../assets/cuy-logo.png';

interface Props {
  size?: number;
  class?: string;
}
const { size = 40, class: className } = Astro.props;
---

<Image
  src={cuyLogo}
  alt=""
  aria-hidden="true"
  width={size}
  height={size}
  densities={[1, 2, 3]}
  format="webp"
  class:list={['cuy-mark', className]}
/>
