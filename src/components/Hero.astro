---
import {
  ArrowUpRight,
  ArrowDown,
  Check,
  LayoutDashboard,
  Boxes,
  Users,
  Settings,
  Plus,
  Ellipsis,
  Globe,
  Smartphone,
  Cloud,
  Sparkles,
  TrendingUp,
} from '@lucide/astro';
import CuyMark from './CuyMark.astro';
import { getCopy, type Locale } from '../i18n/content';
const { locale } = Astro.props as { locale: Locale };
const c = getCopy(locale);
const es = locale === 'es';
// Each headline pairs with the rotating word and icon at the same index.
const titles = es
  ? ['Más de 8 años', 'Rápidos y a tu medida', 'Listos para escalar', 'Con propósito claro']
  : ['Over 8 years', 'Fast and tailored', 'Built to scale', 'With a clear purpose'];
const words = es
  ? ['apps móviles', 'sitios web', 'productos SaaS', 'soluciones con IA']
  : ['mobile apps', 'websites', 'SaaS products', 'AI solutions'];
const fullSentence = es
  ? 'Más de 8 años creando apps móviles, sitios web, productos SaaS y soluciones con IA'
  : 'Over 8 years building mobile apps, websites, SaaS products and AI solutions';
const strip = es
  ? ['Web', 'Android', 'iOS', 'SaaS', 'Inteligencia artificial', 'Automatización', 'Integraciones', 'Mantenimiento']
  : ['Web', 'Android', 'iOS', 'SaaS', 'Artificial intelligence', 'Automation', 'Integrations', 'Maintenance'];
---

<section class="hero wrap">
  <div class="hero-copy">
    <h1>
      {c.hero.title}
      <br />
      <span>{c.hero.accent}</span>
    </h1>
    <p>{c.hero.description}</p>
    <a href="#contacto" class="button button-primary">
      {c.hero.primary}
      <ArrowUpRight size={20} />
    </a>
    <a href="#servicios" class="hero-secondary">
      {c.hero.secondary}
      <ArrowDown size={16} />
    </a>
    <div class="hero-proof">
      <span class="proof-chip" aria-hidden="true">
        <span class="proof-icon is-active" data-icon><Smartphone size={17} stroke-width={2} /></span>
        <span class="proof-icon" data-icon><Globe size={17} stroke-width={2} /></span>
        <span class="proof-icon" data-icon><Cloud size={17} stroke-width={2} /></span>
        <span class="proof-icon" data-icon><Sparkles size={17} stroke-width={2} /></span>
      </span>
      <p>
        <span class="sr-only">{fullSentence}</span>
        <span aria-hidden="true">
          <strong class="proof-words proof-titles">
            {titles.map((t, i) => (
              <span class:list={['proof-word', { 'is-active': i === 0 }]} data-title>{t}</span>
            ))}
          </strong>
          <br />
          {es ? 'creando' : 'building'}
          <span class="proof-words">
            {words.map((w, i) => (
              <span class:list={['proof-word', { 'is-active': i === 0 }]} data-word>{w}</span>
            ))}
          </span>
        </span>
      </p>
    </div>
  </div>
  <div class="hero-art">
    <div class="product-demo">
      <div class="demo-top">
        <CuyMark size={28} class="demo-logo" />
        <strong>{es ? 'Mi espacio de trabajo' : 'My workspace'}</strong>
        <Ellipsis size={20} />
      </div>
      <div class="demo-body">
        <aside class="demo-sidebar" aria-hidden="true">
          <LayoutDashboard size={19} />
          <Boxes size={19} />
          <Users size={19} />
          <Settings size={19} />
        </aside>
        <div class="demo-content">
          <div class="demo-title">
            <div>
              <small>
                {es ? 'Todo en su lugar' : 'Everything in its place'}
              </small>
              <p class="demo-heading">
                {es ? 'Tu negocio, conectado.' : 'Your business, connected.'}
              </p>
            </div>
            <span class="demo-plus">
              <Plus size={17} />
            </span>
          </div>
          <div class="demo-stats">
            <div>
              <small>{es ? 'Proyectos activos' : 'Active projects'}</small>
              <strong>
                12 <TrendingUp size={17} />
              </strong>
            </div>
            <div>
              <small>{es ? 'Tareas completadas' : 'Tasks completed'}</small>
              <strong>
                84 <TrendingUp size={17} />
              </strong>
            </div>
          </div>
          <div class="demo-project">
            <span class="project-initial">W</span>
            <div>
              <strong>{es ? 'Plataforma web' : 'Web platform'}</strong>
              <small>
                {es ? 'Diseño y desarrollo' : 'Design & development'}
              </small>
            </div>
            <span class="demo-badge">{es ? 'En marcha' : 'In progress'}</span>
          </div>
          <div class="demo-chart" aria-hidden="true">
            {[34, 51, 43, 67, 59, 80, 73, 94, 85, 100].map((h, i) => (
              <span style={`--bar-height:${h}%;--bar-index:${i}`}></span>
            ))}
          </div>
          <div class="demo-chart-label">
            <span>
              {es
                ? 'El progreso se construye, paso a paso.'
                : 'Progress is built, step by step.'}
            </span>
            <TrendingUp size={16} />
          </div>
        </div>
      </div>
    </div>
    <div class="floating-note">
      <span>
        <Check size={19} />
      </span>
      <div>
        <strong>{es ? 'Hecho a tu medida' : 'Made for you'}</strong>
        <small>
          {es ? 'Tu idea. Nuestro compromiso.' : 'Your idea. Our commitment.'}
        </small>
      </div>
    </div>
  </div>
</section>
<div class="capability-strip" data-reveal>
  <div class="strip-marquee">
    <div class="strip-track">
      <ul class="strip-list">
        {strip.map((t) => (
          <li>{t}</li>
        ))}
      </ul>
      <ul class="strip-list strip-list-copy" aria-hidden="true">
        {strip.map((t) => (
          <li>{t}</li>
        ))}
      </ul>
    </div>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('.hero-proof');
  if (root) {
    const icons = [...root.querySelectorAll<HTMLElement>('[data-icon]')];
    const words = [...root.querySelectorAll<HTMLElement>('[data-word]')];
    const titles = [...root.querySelectorAll<HTMLElement>('[data-title]')];
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const n = Math.min(icons.length, words.length);
    let index = 0;
    let timer: number | undefined;
    let visible = true;

    const show = (next: number) => {
      for (const list of [words, icons, titles]) {
        list[index].classList.remove('is-active');
        list[index].classList.add('is-past');
      }
      index = next;
      for (const list of [words, icons, titles]) {
        list[index].classList.remove('is-past');
        list[index].classList.add('is-active');
      }
    };
    const tick = () => show((index + 1) % n);
    const stop = () => {
      if (timer !== undefined) window.clearInterval(timer);
      timer = undefined;
    };
    const sync = () => {
      stop();
      if (!reduce.matches && visible && !document.hidden) {
        timer = window.setInterval(tick, 2400);
      }
    };

    if (!reduce.matches) {
      new IntersectionObserver((entries) => {
        visible = entries[entries.length - 1].isIntersecting;
        sync();
      }).observe(root);
      document.addEventListener('visibilitychange', sync);
    }
    reduce.addEventListener('change', () => {
      if (reduce.matches) {
        stop();
        [words, icons, titles].forEach((list) =>
          list.forEach((el, i) => {
            el.classList.toggle('is-active', i === 0);
            el.classList.remove('is-past');
          }),
        );
        index = 0;
      } else {
        sync();
      }
    });
  }
</script>
