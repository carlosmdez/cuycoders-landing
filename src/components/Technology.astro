---
import { ArrowUpRight, Globe, Smartphone, Cloud } from '@lucide/astro';
import { getCopy, type Locale } from '../i18n/content';
const { locale } = Astro.props as { locale: Locale };
const c = getCopy(locale);
const es = locale === 'es';
---

<section class="section technology">
  <div class="wrap">
    <div class="section-head">
      <h2>
        {es ? 'Elegimos la tecnología' : 'We pick the technology'}
        <br />
        <span>{es ? 'que mejor te sirve.' : 'that fits your project.'}</span>
      </h2>
      <div>
        <p class="section-intro">{c.technology.description}</p>
        <a class="text-link" href="#contacto">
          {es ? 'Encontremos tu solución' : 'Let’s find your solution'}
          <ArrowUpRight size={18} />
        </a>
      </div>
    </div>
    <div class="tech-grid">
      <article class="tech-item">
        <div class="tech-visual tech-visual-stack" aria-hidden="true">
          <span class="stack-chip"><Globe size={16} />Web</span>
          <span class="stack-chip"><Smartphone size={16} />{es ? 'Móvil' : 'Mobile'}</span>
          <span class="stack-chip"><Cloud size={16} />Cloud</span>
        </div>
        <h3>
          {es
            ? 'Una base que puede evolucionar'
            : 'A foundation that can evolve'}
        </h3>
        <p>
          {es
            ? 'Desarrollo web y móvil, integraciones y arquitectura cloud. Adoptamos herramientas actuales con atención a la seguridad, el rendimiento y el mantenimiento.'
            : 'Web and mobile development, integrations and cloud architecture. We adopt modern tools with attention to security, performance and maintenance.'}
        </p>
      </article>
      <article class="tech-item">
        <div class="tech-visual tech-visual-ai" aria-hidden="true">
          <span class="ai-bubble ai-bubble-user">
            {es ? '¿Pedidos pendientes hoy?' : 'Pending orders today?'}
          </span>
          <span class="ai-bubble ai-bubble-reply">
            {es ? '12 pedidos, 3 urgentes' : '12 orders, 3 urgent'}
          </span>
        </div>
        <h3>{es ? 'IA donde aporta valor' : 'AI where it adds value'}</h3>
        <p>
          {es
            ? 'Automatización, búsqueda y asistentes conectados a tu información. Evaluamos la precisión y la privacidad antes de llevarlos al producto.'
            : 'Automation, search and assistants connected to your information. We evaluate accuracy and privacy before bringing them into your product.'}
        </p>
      </article>
    </div>
  </div>
</section>
