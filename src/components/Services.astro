---
import {
  ArrowUpRight,
  Brain,
  Building,
  Globe,
  Layers,
  Smartphone,
} from '@lucide/astro';
import { getCopy, type Locale } from '../i18n/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getCopy(locale);
---

<section
  id="servicios"
  class="section services-section"
  aria-labelledby="services-title"
>
  <div class="wrap">
    <div class="section-head">
      <h2 id="services-title">{copy.services.title}</h2>
      <p class="section-intro">{copy.services.intro}</p>
    </div>

    <ul class="services-list">
      {copy.services.items.map((service) => (
        <li class="service-row">
          <div class="service-copy">
            <h3>{service.title}</h3>
            <p>{service.description}</p>
          </div>
          <span class="service-icon" aria-hidden="true">
            {service.icon === 'globe' && <Globe size={24} stroke-width={1.7} />}
            {service.icon === 'smartphone' && (
              <Smartphone size={24} stroke-width={1.7} />
            )}
            {service.icon === 'layers' && (
              <Layers size={24} stroke-width={1.7} />
            )}
            {service.icon === 'building' && (
              <Building size={24} stroke-width={1.7} />
            )}
            {service.icon === 'brain' && <Brain size={24} stroke-width={1.7} />}
          </span>
        </li>
      ))}
    </ul>

    <a class="text-link" href="#contacto">
      {copy.hero.primary}
      <ArrowUpRight size={18} stroke-width={1.8} aria-hidden="true" />
    </a>
  </div>
</section>
