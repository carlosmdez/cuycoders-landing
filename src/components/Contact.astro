---
import { ArrowUpRight } from '@lucide/astro';
import { getCopy, type Locale } from '../i18n/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getCopy(locale);
const isSpanish = locale === 'es';
const demoNotice = isSpanish
  ? 'Vista previa: este formulario no envía mensajes. No se guardan los datos que escribas.'
  : 'Preview: this form does not send messages. The details you enter are not saved.';
const localSuccess = isSpanish
  ? 'Es una demostración local: no se envió ningún mensaje.'
  : 'This is a local demo; no message was sent.';
const placeholders = isSpanish
  ? {
      name: 'Tu nombre',
      email: 'tu@correo.com',
      service: 'Elige una opción',
      message: '¿Qué te gustaría resolver o construir?',
    }
  : {
      name: 'Your name',
      email: 'you@email.com',
      service: 'Choose an option',
      message: 'What would you like to solve or build?',
    };
---

<section
  id="contacto"
  class="section contact-section"
  aria-labelledby="contact-title"
>
  <div class="wrap">
    <div class="contact-grid">
      <div class="contact-copy">
        <div class="section-head">
          <h2 id="contact-title">{copy.contact.title}</h2>
          <p class="section-intro">{copy.contact.description}</p>
        </div>
      </div>

      <form
        class="contact-form"
        data-contact-form
        data-success={localSuccess}
        aria-describedby="contact-demo-notice"
        novalidate={false}
      >
        <p class="form-note" id="contact-demo-notice">
          {demoNotice}
        </p>

        <div class="field">
          <label for="contact-name">{copy.contact.name}</label>
          <input
            id="contact-name"
            name="name"
            type="text"
            autocomplete="name"
            placeholder={placeholders.name}
            required
          />
        </div>

        <div class="field">
          <label for="contact-email">{copy.contact.email}</label>
          <input
            id="contact-email"
            name="email"
            type="email"
            autocomplete="email"
            placeholder={placeholders.email}
            required
          />
        </div>

        <div class="field">
          <label for="contact-service">{copy.contact.service}</label>
          <select id="contact-service" name="service" required>
            <option value="" disabled selected>
              {placeholders.service}
            </option>
            {copy.contact.services.map((service) => (
              <option value={service}>{service}</option>
            ))}
          </select>
        </div>

        <div class="field">
          <label for="contact-message">{copy.contact.message}</label>
          <textarea
            id="contact-message"
            name="message"
            rows="4"
            placeholder={placeholders.message}
            required
          ></textarea>
        </div>

        <button class="button button-primary" type="submit" disabled>
          {isSpanish ? 'Probar formulario' : 'Try demo form'}
          <ArrowUpRight size={18} stroke-width={1.8} aria-hidden="true" />
        </button>
        <p
          class="form-note"
          role="status"
          aria-live="polite"
          data-contact-status
        ></p>
        <noscript>
          {isSpanish
            ? 'Activa JavaScript para probar esta demostración. El formulario no envía mensajes.'
            : 'Enable JavaScript to try this demo. The form does not send messages.'}
        </noscript>
      </form>
    </div>
  </div>
</section>

<script>
  document
    .querySelectorAll<HTMLFormElement>('[data-contact-form]')
    .forEach((form) => {
      form.addEventListener('submit', (event) => {
        event.preventDefault();

        if (!form.reportValidity()) return;

        const status = form.querySelector<HTMLElement>('[data-contact-status]');
        if (status) status.textContent = form.dataset.success ?? '';
      });
      const button = form.querySelector<HTMLButtonElement>(
        'button[type="submit"]',
      );
      if (button) button.disabled = false;
    });
</script>
