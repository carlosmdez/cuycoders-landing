---
import { ArrowUpRight, ChevronDown, CircleCheck } from '@lucide/astro';
import { getCopy, type Locale } from '../i18n/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getCopy(locale);
const isSpanish = locale === 'es';
const placeholders = isSpanish
  ? {
      name: 'Tu nombre',
      email: 'tu@correo.com',
      service: 'Elige una opción',
      message: '¿Qué te gustaría resolver o construir?',
    }
  : {
      name: 'Your name',
      email: 'you@email.com',
      service: 'Choose an option',
      message: 'What would you like to solve or build?',
    };
---

<section
  id="contacto"
  class="section contact-section"
  aria-labelledby="contact-title"
>
  <div class="wrap">
    <div class="contact-grid">
      <div class="contact-copy">
        <div class="section-head">
          <h2 id="contact-title">{copy.contact.title}</h2>
          <p class="section-intro">{copy.contact.description}</p>
        </div>
      </div>

      <div class="contact-card" data-contact-card>
        <div class="contact-card-inner">
          <form
            class="contact-form"
            data-contact-form
            action="https://formserve.io/f/rvcKqtYUGPA"
            method="POST"
            data-sending={copy.contact.sending}
            data-error={copy.contact.error}
          >
            <input type="hidden" name="language" value={locale} />
            <input type="hidden" name="_fs_loaded_at" data-loaded-at />
            <input
              class="form-honeypot"
              type="text"
              name="_honeypot"
              tabindex="-1"
              autocomplete="off"
              aria-hidden="true"
            />

            <div class="field">
              <label for="contact-name">{copy.contact.name}</label>
              <input
                id="contact-name"
                name="name"
                type="text"
                autocomplete="name"
                placeholder={placeholders.name}
                required
              />
            </div>

            <div class="field">
              <label for="contact-email">{copy.contact.email}</label>
              <input
                id="contact-email"
                name="email"
                type="email"
                autocomplete="email"
                placeholder={placeholders.email}
                required
              />
            </div>

            <div class="field">
              <label for="contact-service">{copy.contact.service}</label>
              <div class="select-wrap">
                <select id="contact-service" name="service" required>
                  <option value="" disabled selected>
                    {placeholders.service}
                  </option>
                  {copy.contact.services.map((service) => (
                    <option value={service}>{service}</option>
                  ))}
                </select>
                <ChevronDown size={18} stroke-width={1.8} aria-hidden="true" />
              </div>
            </div>

            <div class="field">
              <label for="contact-message">{copy.contact.message}</label>
              <textarea
                id="contact-message"
                name="message"
                rows="4"
                placeholder={placeholders.message}
                required
              ></textarea>
            </div>

            <button class="button button-primary" type="submit">
              <span data-submit-label>{copy.contact.button}</span>
              <ArrowUpRight size={18} stroke-width={1.8} aria-hidden="true" />
            </button>
            <p
              class="form-note"
              role="status"
              aria-live="polite"
              data-contact-status
            ></p>
          </form>
          <div
            class="contact-success"
            data-contact-success
            hidden
            tabindex="-1"
            role="status"
            aria-labelledby="contact-success-title"
          >
            <CircleCheck size={48} stroke-width={1.5} aria-hidden="true" />
            <h3 id="contact-success-title">{copy.contact.successTitle}</h3>
            <p>{copy.contact.success}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { initContactForms } from '../lib/contact-form';
  initContactForms();
</script>
