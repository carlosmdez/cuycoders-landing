---
import { ArrowUpRight, ArrowRight, Brain, Sparkles } from '@lucide/astro';
import type { CollectionEntry } from 'astro:content';
import { getCopy, type Locale } from '../i18n/content';
interface Props {
  locale: Locale;
  posts: CollectionEntry<'blog'>[];
  standalone?: boolean;
}
const { locale, posts, standalone = false } = Astro.props;
const c = getCopy(locale);
// Cover illustration by article identity: 0 sage/custom software, 1 peach/business discovery, 2 lilac/AI.
const coverByKey: Record<string, number> = {
  'custom-software': 0,
  'purposeful-ai': 2,
  'understand-business': 1,
};
const variant = (key: string, i: number) => coverByKey[key] ?? i % 3;
const Title = standalone ? 'h2' : 'h3';
---

<section class:list={['wrap', standalone ? 'blog-index-list' : 'section']}>
  <div class="section-head">
    {!standalone && <h2>{c.blog.title}</h2>}
    <p class="section-intro">{c.blog.description}</p>
    {!standalone && (
      <a class="text-link" href={`/${locale}/blog/`}>
        {c.blog.link}
        <ArrowUpRight size={18} />
      </a>
    )}
  </div>
  <div class="blog-grid">
    {posts.map((post, i) => (
      <article class="blog-card">
        <a
          href={`/${locale}/blog/${post.id}/`}
          class="blog-cover"
          tabindex="-1"
          aria-label={post.data.title}
        >
          <span class:list={['cover-art', `cover-${variant(post.data.translationKey, i)}`]} aria-hidden="true">
            {variant(post.data.translationKey, i) === 0 ? (
              <div class="cv-custom">
                <b class="cv-q q1">?</b>
                <b class="cv-q q2">?</b>
                <b class="cv-q q3">?</b>
                <b class="cv-q q4">?</b>
                <div class="cv-window">
                  <span></span>
                  <span></span>
                  <span></span>
                  <i class="bar"></i>
                  <i class="block"></i>
                </div>
              </div>
            ) : variant(post.data.translationKey, i) === 2 ? (
              <div class="cv-ai">
                <span class="cv-brain"><Brain size={44} stroke-width={1.8} /></span>
                <span class="cv-chip"><Sparkles size={13} />{locale === 'es' ? 'IA' : 'AI'}</span>
              </div>
            ) : (
              <div class="cv-biz">
                <div class="cv-doc back"><i></i><i></i><i></i><i class="accent"></i></div>
                <div class="cv-doc front"><i></i><i></i><i></i><i class="accent"></i></div>
                <div class="cv-lens"><i></i></div>
                <span class="cv-handle"></span>
              </div>
            )}
          </span>
        </a>
        <div class="article-meta">
          <span>{post.data.category}</span>
          <span>
            {post.data.readTime} {c.common.minutes}
          </span>
        </div>
        <Title class="blog-card-title">
          <a href={`/${locale}/blog/${post.id}/`}>
            {post.data.title}
            <ArrowUpRight size={20} />
          </a>
        </Title>
        <p>{post.data.description}</p>
        <a class="text-link" href={`/${locale}/blog/${post.id}/`}>
          {c.common.read}
          <ArrowRight size={16} />
        </a>
      </article>
    ))}
  </div>
</section>
