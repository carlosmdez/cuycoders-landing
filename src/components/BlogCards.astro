---
import { ArrowUpRight, ArrowRight, Asterisk } from '@lucide/astro';
import type { CollectionEntry } from 'astro:content';
import { getCopy, type Locale } from '../i18n/content';
interface Props {
  locale: Locale;
  posts: CollectionEntry<'blog'>[];
  standalone?: boolean;
}
const { locale, posts, standalone = false } = Astro.props;
const c = getCopy(locale);
---

<section class:list={['wrap', standalone ? 'blog-index-list' : 'section']}>
  <div class="section-head">
    {!standalone && <h2>{c.blog.title}</h2>}
    <p class="section-intro">{c.blog.description}</p>
    {!standalone && (
      <a class="text-link" href={`/${locale}/blog/`}>
        {c.blog.link}
        <ArrowUpRight size={18} />
      </a>
    )}
  </div>
  <div class="blog-grid">
    {posts.map((post, i) => (
      <article class="blog-card">
        <a
          href={`/${locale}/blog/${post.id}/`}
          class="blog-cover"
          tabindex="-1"
          aria-hidden="true"
        >
          <span class:list={['cover-art', `cover-${i % 3}`]}>
            {i % 3 === 0 ? (
              <>
                <span class="cover-shape shape-left"></span>
                <span class="cover-shape shape-right"></span>
                <span class="cover-connector"></span>
              </>
            ) : i % 3 === 1 ? (
              <>
                <span class="cover-frame"></span>
                <span class="cover-frame inner"></span>
                <span class="cover-frame core"></span>
              </>
            ) : (
              <>
                <Asterisk class="ai-asterisk" size={130} stroke-width={1.3} />
              </>
            )}
          </span>
        </a>
        <div class="article-meta">
          <span>{post.data.category}</span>
          <span>
            {post.data.readTime} {c.common.minutes}
          </span>
        </div>
        <h3>
          <a href={`/${locale}/blog/${post.id}/`}>
            {post.data.title}
            <ArrowUpRight size={20} />
          </a>
        </h3>
        <p>{post.data.description}</p>
        <a class="text-link" href={`/${locale}/blog/${post.id}/`}>
          {c.common.read}
          <ArrowRight size={16} />
        </a>
      </article>
    ))}
  </div>
</section>
