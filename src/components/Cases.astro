---
import {
  ArrowUpRight,
  Truck,
  TrendingUp,
  Check,
  MapPin,
} from '@lucide/astro';
import { getCopy, type Locale } from '../i18n/content';
const { locale } = Astro.props as { locale: Locale };
const c = getCopy(locale);
const es = locale === 'es';
---

<section class="section wrap" id="casos">
  <div class="section-head">
    <h2>{c.cases.title}</h2>
    <p class="section-intro">{c.cases.intro}</p>
  </div>
  <div class="cases-grid">
    {c.cases.items.map((item, i) => (
      <article
        class:list={['case-item', `case-${i}`]}
      >
        <div class="case-visual" aria-hidden="true">
          {i === 0 ? (
            <div class="logistics-map">
              <div class="logistics-stage">
                <svg class="logistics-route" viewBox="0 0 240 100" preserveAspectRatio="none">
                  <path d="M30 76 C 70 76, 84 26, 120 44 S 176 30, 206 28" vector-effect="non-scaling-stroke" />
                </svg>
                <span class="logistics-origin"></span>
                <span class="logistics-pin"><MapPin size={22} fill="currentColor" /></span>
                <span class="logistics-truck"><Truck size={16} /></span>
              </div>
              <span class="logistics-status">
                <i></i>{es ? 'En ruta · 3 entregas' : 'On route · 3 deliveries'}
              </span>
            </div>
          ) : i === 1 ? (
            <div class="saas-art">
              <div class="saas-window">
                <span></span>
                <span></span>
                <span></span>
                <div></div>
                <div></div>
              </div>
              <span class="saas-pill">
                <TrendingUp size={14} />+24%
              </span>
            </div>
          ) : (
            <div class="mobile-art">
              <div class="phone">
                <span class="phone-notch"></span>
                <div class="phone-feed">
                  <span class="phone-row"><i></i><span><b></b><b></b></span></span>
                  <span class="phone-row"><i></i><span><b></b><b></b></span></span>
                  <span class="phone-row"><i></i><span><b></b><b></b></span></span>
                  <span class="phone-row"><i></i><span><b></b><b></b></span></span>
                  <span class="phone-row"><i></i><span><b></b><b></b></span></span>
                  <span class="phone-action">
                    <Check size={18} />
                  </span>
                </div>
              </div>
            </div>
          )}
        </div>
        <p class="case-category">{item.category}</p>
        <h3>{item.title}</h3>
        <p>{item.description}</p>
        <a class="text-link" href="#contacto">
          {es ? 'Hablemos de tu caso' : 'Let’s discuss your use case'}
          <ArrowUpRight size={17} />
        </a>
      </article>
    ))}
  </div>
</section>
