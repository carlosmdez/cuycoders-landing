---
import '../styles/global.css';
import '../styles/fonts.css';
import manropeFont from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import dmSansFont from '@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url';
import { serializeJsonLd } from '../lib/seo';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCopy, type Locale } from '../i18n/content';
interface Props {
  locale: Locale;
  title: string;
  description: string;
  alternatePath?: string;
  schema?: Record<string, unknown>;
}
const {
  locale,
  title,
  description,
  alternatePath = `/${locale === 'es' ? 'en' : 'es'}/`,
  schema,
} = Astro.props;
const c = getCopy(locale);
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;
const alternate = Astro.site ? new URL(alternatePath, Astro.site) : undefined;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href={manropeFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={dmSansFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f8f6f0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && (
      <>
        <link rel="canonical" href={canonical} />
        <link rel="alternate" hreflang={locale} href={canonical} />
        <link
          rel="alternate"
          hreflang={locale === 'es' ? 'en' : 'es'}
          href={alternate}
        />
        <link
          rel="alternate"
          hreflang="x-default"
          href={locale === 'es' ? canonical : alternate}
        />
        <meta property="og:url" content={canonical} />
      </>
    )}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta
      property="og:type"
      content={schema?.['@type'] === 'BlogPosting' ? 'article' : 'website'}
    />
    <meta property="og:site_name" content="Cuy Coders" />
    <meta property="og:locale" content={locale === 'es' ? 'es_ES' : 'en_US'} />
    <meta
      property="og:locale:alternate"
      content={locale === 'es' ? 'en_US' : 'es_ES'}
    />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:card" content="summary" />
    {schema && (
      <script type="application/ld+json" set:html={serializeJsonLd(schema)} />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">
      {c.common.skip}
    </a>
    <Header locale={locale} alternatePath={alternatePath} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
