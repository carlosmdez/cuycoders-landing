{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "deploy": {
    "inputs": [
      {
        "image": "caddy:2-alpine",
        "include": [
          "/usr/bin/caddy"
        ]
      },
      {
        "step": "build",
        "include": [
          "dist",
          "Caddyfile"
        ]
      }
    ],
    "startCommand": "caddy run --config /app/Caddyfile --adapter caddyfile",
    "variables": {
      "STATIC_ROOT": "/app/dist"
    }
  }
}
