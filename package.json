{
  "name": "cuy-coders-landing",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "dev": "bun ./node_modules/astro/bin/astro.mjs dev",
    "build": "bun ./node_modules/astro/bin/astro.mjs build",
    "preview": "bun ./node_modules/astro/bin/astro.mjs preview",
    "astro": "bun ./node_modules/astro/bin/astro.mjs",
    "check": "bun ./node_modules/astro/bin/astro.mjs check",
    "format": "bun --bun prettier --write src astro.config.mjs",
    "verify:build": "bun scripts/verify-build.mjs",
    "test:seo": "bun test scripts/seo.test.mjs",
    "verify:serving": "bun scripts/verify-serving.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@lucide/astro": "^1.53.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0"
  },
  "packageManager": "bun@1.4.2"
}
